{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Order",
  "description": "A single order placed by a customer.",
  "type": "object",
  "required": ["id", "items"],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$",
      "description": "How this order is referred to everywhere else."
    },
    "status": {
      "enum": ["draft", "placed", "shipped"],
      "default": "draft"
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/line" }
    },
    "giftMessage": { "type": "string", "maxLength": 200 }
  },
  "$defs": {
    "line": {
      "type": "object",
      "required": ["sku", "quantity"],
      "properties": {
        "sku": { "type": "string" },
        "quantity": { "type": "integer", "minimum": 1, "maximum": 99 }
      }
    }
  }
}

{
 "type": "object",
 "additionalProperties": false,
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "Order",
 "description": "A single order placed by a customer.",
 "properties": {
  "id": {
   "type": "string",
   "pattern": "^[a-z0-9-]+$",
   "description": "How this order is referred to everywhere else."
  },
  "status": {
   "default": "draft",
   "enum": [
    "draft",
    "placed",
    "shipped"
   ]
  },
  "items": {
   "type": "array",
   "items": {
    "$ref": "#/$defs/line"
   },
   "minItems": 1
  },
  "giftMessage": {
   "type": "string",
   "maxLength": 200
  }
 },
 "required": [
  "id",
  "items"
 ],
 "$defs": {
  "line": {
   "type": "object",
   "properties": {
    "sku": {
     "type": "string"
    },
    "quantity": {
     "type": "integer",
     "minimum": 1,
     "maximum": 99
    }
   },
   "required": [
    "sku",
    "quantity"
   ]
  }
 }
}